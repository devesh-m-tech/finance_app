PORT=4000
NODE_ENV=development

# MongoDB 7 Replica Set
MONGODB_URI=mongodb://localhost:27017/shri_amudha_finance?replicaSet=rs0

# Redis (BullMQ & Permissions Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Secrets
JWT_ACCESS_SECRET=super_secret_access_jwt_key_at_least_32_characters
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HMAC_SECRET=hmac_salt_for_deterministic_hash_generation

# S3 / MinIO Object Storage
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=shri-amudha-documents

# Adapter Providers (mock | real)
CIBIL_PROVIDER=mock
CIBIL_API_KEY=
CIBIL_MEMBER_ID=

KYC_PROVIDER=mock
KYC_API_KEY=

SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=SHRFNC

WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

FINGERPRINT_PROVIDER=mock

# CORS Allow List
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:19006,exp://localhost:8081
